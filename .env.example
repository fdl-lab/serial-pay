# =============================================================================
# Serial Pay — 環境変数
# コピー: cp .env.example .env.local
# =============================================================================

# --- あなたが用意するもの ---

# PostgreSQL（Supabase 推奨）
# 取得: Supabase → Project Settings → Database → Connection string (URI)
# 手順の詳細: docs/SUPABASE.md
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.xxxx.supabase.co:5432/postgres?schema=public"

# シリアル暗号化キー（32バイトを base64）
# 生成例: openssl rand -base64 32
SERIAL_ENCRYPTION_KEY=""

# codeHash 用ペッパー
# 生成例: openssl rand -base64 32
SERIAL_CODE_HASH_PEPPER=""

# Stripe（Dashboard → Developers）
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Connect のプラットフォーム手数料（%）
STRIPE_PLATFORM_FEE_PERCENT="10"

# LINE Login（アプリ直結・推奨）
# LINE Developers → LINE Login チャネルの Channel ID / Secret
LINE_CHANNEL_ID=""
LINE_CHANNEL_SECRET=""
# LINE Developers のコールバックURLと一字一句合わせる
LINE_CALLBACK_URL="http://127.0.0.1:3000/api/auth/line/callback"
# 手順: docs/LINE_EKYC.md

# Supabase（DB用。Auth の LINE プロバイダは不要）
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# （任意）旧SMS用
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""

# eKYC（Stripe Identity 推奨）
EKYC_PROVIDER="stripe_identity"

# オブジェクトストレージ（画録・コード画像）※本番必須
# 例: Cloudflare R2 / AWS S3 / GCS
S3_BUCKET=""
S3_REGION="ap-northeast-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
# 公開 or 署名付きURL用
S3_PUBLIC_BASE_URL=""

# --- アプリ設定 ---
CONFIRMATION_WINDOW_MINUTES="30"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 開発用: 認証をスキップして固定ユーザーで動かす（本番は必ず false）
# サーバー側とクライアント側の両方を揃える
DEV_AUTH_BYPASS="true"
NEXT_PUBLIC_DEV_AUTH_BYPASS="true"
DEV_USER_ID=""
NEXT_PUBLIC_DEV_USER_ID=""

# seed 時の出品者 Connect アカウント（Stripe テスト acct_xxx）
SEED_CONNECT_ACCOUNT_ID=""
